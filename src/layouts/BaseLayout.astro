---
import '../styles/global.css';
import { House, Info, LayoutGrid, Menu, Search, X } from '@lucide/astro';
import { siteInfo } from '../data/site';
import { assetHref, href } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title = siteInfo.name,
  description = siteInfo.description,
  image = '/brand/banner-light-16x9.webp',
  noIndex = false
} = Astro.props;

const pageTitle = title === siteInfo.name ? title : `${title}｜${siteInfo.shortName}`;
const canonical = Astro.url.href;
const shareImage = new URL(assetHref(image), Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f8ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081326" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={assetHref('/brand/mark.webp')} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteInfo.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand-link" href={href('/')} aria-label="返回首页">
          <img src={assetHref('/brand/mark.webp')} alt="" width="44" height="44" />
          <span>{siteInfo.shortName}</span>
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-label="打开菜单"
          aria-expanded="false"
          aria-controls="main-navigation"
          data-menu-toggle
        >
          <Menu class="menu-open-icon" size={22} aria-hidden="true" />
          <X class="menu-close-icon" size={22} aria-hidden="true" />
        </button>

        <nav id="main-navigation" class="main-nav" aria-label="主导航" data-main-nav>
          <a href={href('/')}><House size={16} aria-hidden="true" />首页</a>
          <a href={href('/category/all')}><LayoutGrid size={16} aria-hidden="true" />全部作品</a>
          <a href={href('/about')}><Info size={16} aria-hidden="true" />关于工作室</a>
        </nav>

        <form class="header-search" action={href('/search')} role="search">
          <label class="sr-only" for="header-search-input">搜索作品</label>
          <input id="header-search-input" name="q" type="search" placeholder="搜索作品" />
          <button type="submit"><Search size={15} aria-hidden="true" /><span>搜索</span></button>
        </form>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src={assetHref('/brand/mark.webp')} alt="" width="38" height="38" />
          <div>
            <strong>蓝桥工作室作品展示集</strong>
            <p>轻巧、实用、有趣的小程序作品。</p>
          </div>
        </div>
        <nav class="footer-links" aria-label="页脚导航">
          <a href={href('/category/all')}>全部作品</a>
          <a href={href('/about')}>关于</a>
        </nav>
        <small>{siteInfo.copyright}</small>
      </div>
    </footer>
    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mainNav = document.querySelector<HTMLElement>('[data-main-nav]');

      const closeMenu = () => {
        menuToggle?.setAttribute('aria-expanded', 'false');
        menuToggle?.setAttribute('aria-label', '打开菜单');
        mainNav?.removeAttribute('data-open');
      };

      menuToggle?.addEventListener('click', () => {
        const open = menuToggle.getAttribute('aria-expanded') === 'true';
        if (open) {
          closeMenu();
        } else {
          menuToggle.setAttribute('aria-expanded', 'true');
          menuToggle.setAttribute('aria-label', '关闭菜单');
          mainNav?.setAttribute('data-open', '');
        }
      });

      mainNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
      document.addEventListener('click', (event) => {
        if (!mainNav?.hasAttribute('data-open')) return;
        if (mainNav.contains(event.target as Node) || menuToggle?.contains(event.target as Node)) return;
        closeMenu();
      });
    </script>
  </body>
</html>
