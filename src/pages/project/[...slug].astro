---
import { render } from 'astro:content';
import { ArrowLeft, Clock, Download, Package, Tag, User } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotRail from '../../components/ScreenshotRail.astro';
import ShareDialog from '../../components/ShareDialog.astro';
import { getProjects, type ProjectRecord } from '../../lib/projects';
import { assetHref, href } from '../../lib/urls';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: ProjectRecord;
}

const { project } = Astro.props;
const { entry, category, modifiedAt } = project;
const { Content } = await render(entry);
const mediaImages = [...new Set(
  [entry.data.cover, ...entry.data.screenshots].filter((item): item is string => Boolean(item))
)];
const dateLabel = modifiedAt.getTime() > 0
  ? new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }).format(modifiedAt)
  : '暂无';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover ?? entry.data.icon}
>
  <article class="project-page">
    <header class="project-hero container">
      <a class="back-link" href={href(`/category/${category}`)}>
        <ArrowLeft size={17} aria-hidden="true" />返回{category}
      </a>
      <div class="project-heading">
        <div class:list={['project-hero-icon', { fallback: !entry.data.icon }]}>
          {entry.data.icon
            ? <img src={assetHref(entry.data.icon)} alt="" />
            : <span>{entry.data.title.slice(0, 1)}</span>}
        </div>
        <div class="project-heading-copy">
          <div class="project-labels">
            <span class="category-chip">{category}</span>
            {entry.data.status !== '已发布' && <span class="status-chip">{entry.data.status}</span>}
          </div>
          <h1>{entry.data.title}</h1>
        </div>
      </div>
      <div class="project-actions">
        {entry.data.links.map((link) => (
          <a class="button button-primary" href={link.url} target="_blank" rel="noreferrer">
            {link.label}
          </a>
        ))}
        {entry.data.downloadUrl && (
          <a
            class="button button-download"
            href={entry.data.downloadUrl}
            download
            target="_blank"
            rel="noreferrer"
          >
            <Download size={17} aria-hidden="true" />下载
          </a>
        )}
        <ShareDialog
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.cover ?? entry.data.icon}
        />
      </div>
    </header>

    <div class="container project-content">
      <section class="project-intro" aria-labelledby="project-intro-title">
        <span id="project-intro-title">作品简介</span>
        <p>{entry.data.description}</p>
      </section>

      <section class="project-facts" aria-label="作品信息">
        <div>
          <User size={18} aria-hidden="true" />
          <span>作者</span>
          <a class="developer-link" href={href('/developer')}>{entry.data.author}</a>
        </div>
        <div>
          <Package size={18} aria-hidden="true" />
          <span>包名</span>
          <button type="button" data-copy-package={entry.data.packageName} title="复制包名">
            {entry.data.packageName}
          </button>
        </div>
        <div>
          <Tag size={18} aria-hidden="true" />
          <span>当前版本</span>
          <strong>{entry.data.version}</strong>
        </div>
        <div>
          <Clock size={18} aria-hidden="true" />
          <span>最近修改</span>
          <strong>{dateLabel}</strong>
        </div>
      </section>

      <section class="project-prose" aria-label="作品正文">
        <Content />
      </section>

      <ScreenshotRail screenshots={mediaImages} title={entry.data.title} />
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-package]').forEach((button) => {
    button.addEventListener('click', async () => {
      const packageName = button.dataset.copyPackage ?? '';
      await navigator.clipboard.writeText(packageName);
      const original = button.textContent;
      button.textContent = '已复制';
      window.setTimeout(() => {
        button.textContent = original;
      }, 1300);
    });
  });
</script>

<style>
  .project-page {
    padding-top: 40px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    color: var(--brand-600);
    font-weight: 750;
  }

  .project-heading {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 20px;
  }

  .project-hero-icon {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .project-hero-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-hero-icon.fallback {
    background: var(--brand-600);
    color: white;
    font-size: 3rem;
    font-weight: 900;
  }

  .project-labels {
    display: flex;
    gap: 8px;
  }

  h1 {
    margin: 8px 0 0;
    font-size: clamp(2.2rem, 5vw, 3.7rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .button-download {
    border-color: #159447;
    background: #159447;
    color: white;
    box-shadow: 0 8px 20px rgba(21, 148, 71, 0.2);
  }

  .button-download:hover {
    background: #0f7e3b;
  }

  .project-content {
    display: grid;
    max-width: 920px;
    gap: 26px;
    padding-top: 28px;
  }

  .project-intro {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 18px 20px;
    background: var(--surface);
    box-shadow: var(--shadow-small);
  }

  .project-intro span {
    color: var(--brand-600);
    font-size: 0.76rem;
    font-weight: 850;
  }

  .project-intro p {
    margin: 5px 0 0;
    color: var(--ink-800);
    font-size: 1rem;
    line-height: 1.62;
  }

  .project-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 4px 18px;
    background: var(--surface);
    box-shadow: var(--shadow-small);
  }

  .project-facts > div {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    row-gap: 2px;
    column-gap: 10px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }

  .project-facts > div:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .project-facts > div:nth-child(odd) {
    padding-right: 18px;
  }

  .project-facts > div:nth-child(even) {
    border-left: 1px solid var(--line);
    padding-left: 18px;
  }

  .project-facts span {
    grid-column: 2;
    color: var(--ink-500);
    font-size: 0.76rem;
    font-weight: 750;
  }

  .project-facts strong,
  .project-facts button,
  .project-facts .developer-link {
    grid-column: 2;
    border: 0;
    padding: 0;
    color: var(--ink-800);
    background: transparent;
    font-size: 0.9rem;
    font-weight: 750;
    text-align: left;
    word-break: break-all;
  }

  .project-facts button {
    color: var(--brand-600);
    cursor: copy;
  }

  .project-facts .developer-link {
    color: var(--brand-600);
  }

  .project-prose {
    min-width: 0;
    padding: 2px 2px 0;
    font-size: 0.98rem;
  }

  .project-prose :global(h2) {
    margin: 2.5em 0 0.6em;
    font-size: clamp(1.65rem, 4vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .project-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .project-prose :global(h3) {
    margin-top: 2em;
  }

  .project-prose :global(p),
  .project-prose :global(li) {
    color: var(--ink-800);
  }

  .project-prose :global(a) {
    color: var(--brand-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-prose :global(img) {
    border-radius: 20px;
  }

  .project-prose :global(blockquote) {
    margin-inline: 0;
    border-left: 4px solid var(--brand-500);
    padding: 3px 0 3px 20px;
    color: var(--ink-600);
  }

  @media (max-width: 640px) {
    .project-page {
      padding-top: 18px;
    }

    .back-link {
      margin-bottom: 16px;
      font-size: 0.86rem;
    }

    .project-heading {
      grid-template-columns: 76px 1fr;
      gap: 14px;
    }

    .project-hero-icon {
      width: 76px;
      height: 76px;
      border-radius: 18px;
    }

    .project-hero-icon.fallback {
      font-size: 2.5rem;
    }

    h1 {
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
    }

    .project-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 16px;
    }

    .project-actions :global(.button) {
      min-width: 0;
      padding-inline: 10px;
    }

    .project-content {
      gap: 16px;
      padding-top: 16px;
    }

    .project-intro {
      border-radius: 16px;
      padding: 14px 15px;
    }

    .project-intro p {
      font-size: 0.92rem;
    }

    .project-facts {
      grid-template-columns: 1fr;
      border-radius: 16px;
      padding-inline: 15px;
    }

    .project-facts > div {
      padding: 11px 0;
    }

    .project-facts > div:nth-child(odd) {
      padding-right: 0;
    }

    .project-facts > div:nth-child(even) {
      border-left: 0;
      padding-left: 0;
    }

    .project-facts > div:nth-child(3) {
      border-bottom: 1px solid var(--line);
    }

    .project-prose :global(h2) {
      margin-top: 1.8em;
      font-size: 1.45rem;
    }
  }
</style>
