---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotRail from '../../components/ScreenshotRail.astro';
import ShareDialog from '../../components/ShareDialog.astro';
import { getProjects, type ProjectRecord } from '../../lib/projects';
import { assetHref, href } from '../../lib/urls';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: ProjectRecord;
}

const { project } = Astro.props;
const { entry, category, modifiedAt } = project;
const { Content } = await render(entry);
const dateLabel = modifiedAt.getTime() > 0
  ? new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }).format(modifiedAt)
  : '暂无';
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover ?? entry.data.icon}
>
  <article class="project-page">
    <header class="project-hero container">
      <a class="back-link" href={href(`/category/${category}`)}>← 返回{category}</a>
      <div class="project-heading">
        <div class:list={['project-hero-icon', { fallback: !entry.data.icon }]}>
          {entry.data.icon
            ? <img src={assetHref(entry.data.icon)} alt="" />
            : <span>{entry.data.title.slice(0, 1)}</span>}
        </div>
        <div class="project-heading-copy">
          <div class="project-labels">
            <span class="category-chip">{category}</span>
            {entry.data.status !== '已发布' && <span class="status-chip">{entry.data.status}</span>}
          </div>
          <h1>{entry.data.title}</h1>
          <p>{entry.data.description}</p>
          <div class="project-actions">
            {entry.data.links.map((link) => (
              <a class="button button-primary" href={link.url} target="_blank" rel="noreferrer">
                {link.label}
              </a>
            ))}
            <ShareDialog
              title={entry.data.title}
              description={entry.data.description}
              image={entry.data.cover ?? entry.data.icon}
            />
          </div>
        </div>
      </div>
    </header>

    {entry.data.cover && (
      <figure class="container project-cover">
        <img src={assetHref(entry.data.cover)} alt={`${entry.data.title}宣传海报`} />
      </figure>
    )}

    <div class="container project-body-grid">
      <aside class="project-facts">
        <div>
          <span>作者</span>
          <strong>{entry.data.author}</strong>
        </div>
        <div>
          <span>包名</span>
          <button type="button" data-copy-package={entry.data.packageName} title="复制包名">
            {entry.data.packageName}
          </button>
        </div>
        <div>
          <span>当前版本</span>
          <strong>{entry.data.version}</strong>
        </div>
        <div>
          <span>最近修改</span>
          <strong>{dateLabel}</strong>
        </div>
      </aside>

      <div class="project-prose">
        <Content />
      </div>
    </div>

    <div class="container">
      <ScreenshotRail screenshots={entry.data.screenshots} title={entry.data.title} />
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-package]').forEach((button) => {
    button.addEventListener('click', async () => {
      const packageName = button.dataset.copyPackage ?? '';
      await navigator.clipboard.writeText(packageName);
      const original = button.textContent;
      button.textContent = '已复制';
      window.setTimeout(() => {
        button.textContent = original;
      }, 1300);
    });
  });
</script>

<style>
  .project-page {
    padding-top: 60px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 34px;
    color: var(--brand-600);
    font-weight: 750;
  }

  .project-heading {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .project-hero-icon {
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border: 1px solid var(--line);
    border-radius: 26px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .project-hero-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-hero-icon.fallback {
    background: var(--brand-600);
    color: white;
    font-size: 3rem;
    font-weight: 900;
  }

  .project-labels {
    display: flex;
    gap: 8px;
  }

  h1 {
    margin: 10px 0 6px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  .project-heading-copy > p {
    max-width: 760px;
    margin: 18px 0 0;
    color: var(--ink-600);
    font-size: clamp(1rem, 2.3vw, 1.22rem);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .project-cover {
    width: min(calc(100% - 40px), 720px);
    margin-top: 46px;
  }

  .project-cover img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow-small);
    object-fit: contain;
  }

  .project-body-grid {
    display: grid;
    grid-template-columns: 250px minmax(0, 760px);
    justify-content: space-between;
    gap: 60px;
    padding-top: 56px;
  }

  .project-facts {
    align-self: start;
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 7px 20px;
    background: var(--surface);
    box-shadow: var(--shadow-small);
  }

  .project-facts > div {
    display: grid;
    gap: 2px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }

  .project-facts > div:last-child {
    border-bottom: 0;
  }

  .project-facts span {
    color: var(--ink-500);
    font-size: 0.76rem;
    font-weight: 750;
  }

  .project-facts strong,
  .project-facts button {
    border: 0;
    padding: 0;
    color: var(--ink-800);
    background: transparent;
    font-size: 0.9rem;
    font-weight: 750;
    text-align: left;
    word-break: break-all;
  }

  .project-facts button {
    color: var(--brand-600);
    cursor: copy;
  }

  .project-prose {
    min-width: 0;
    font-size: 1.02rem;
  }

  .project-prose :global(h2) {
    margin: 2.5em 0 0.6em;
    font-size: clamp(1.65rem, 4vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .project-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .project-prose :global(h3) {
    margin-top: 2em;
  }

  .project-prose :global(p),
  .project-prose :global(li) {
    color: var(--ink-800);
  }

  .project-prose :global(a) {
    color: var(--brand-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-prose :global(img) {
    border-radius: 20px;
  }

  .project-prose :global(blockquote) {
    margin-inline: 0;
    border-left: 4px solid var(--brand-500);
    padding: 3px 0 3px 20px;
    color: var(--ink-600);
  }

  @media (max-width: 800px) {
    .project-body-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 640px) {
    .project-heading {
      grid-template-columns: 80px 1fr;
      gap: 18px;
    }

    .project-hero-icon {
      width: 80px;
      height: 80px;
      border-radius: 20px;
    }

    .project-hero-icon.fallback {
      font-size: 2.5rem;
    }

    h1 {
      font-size: clamp(2.35rem, 13vw, 4rem);
    }

    .project-heading-copy > p,
    .project-actions {
      grid-column: 1 / -1;
    }

    .project-cover img {
      border-radius: 16px;
    }
  }
</style>
