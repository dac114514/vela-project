---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { ArrowUpRight, UserPlus } from '@lucide/astro';
import { siteInfo } from '../data/site';
import { getCategoryGroups } from '../lib/projects';
import { assetHref, href } from '../lib/urls';

const groups = await getCategoryGroups();
const perSection = 6;
---

<BaseLayout>
  <section class="banner-section" aria-label="推荐内容">
    <div class="container banner-rail">
      {siteInfo.banners.map((banner) => (
        banner.kind === 'recruitment' ? (
          <a class="market-banner recruitment-banner" href={href(banner.href)}>
            <div class="banner-copy">
              <span>{banner.eyebrow}</span>
              <h2>{banner.title}</h2>
              <p>{banner.description}</p>
              <strong>{banner.action}<ArrowUpRight size={16} aria-hidden="true" /></strong>
            </div>
            <div class="recruitment-mark" aria-hidden="true">
              <UserPlus size={54} stroke-width={1.6} />
            </div>
          </a>
        ) : (
          <a class="market-banner image-banner" href={href(banner.href)}>
            <img src={assetHref(banner.image)} alt={banner.alt} />
          </a>
        )
      ))}
    </div>
  </section>

  <div class="container category-sections">
    {groups.map((group) => (
      <section class="category-section" aria-labelledby={`category-${group.name}`}>
        <div class="section-heading">
          <h2 id={`category-${group.name}`}>{group.name}</h2>
          <a class="section-link" href={href(`/category/${group.name}`)}>
            查看全部
          </a>
        </div>
        <div class="project-grid">
          {group.items.slice(0, perSection).map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .banner-section {
    padding-top: 28px;
  }

  .banner-rail {
    display: grid;
    grid-auto-columns: min(88%, 980px);
    grid-auto-flow: column;
    gap: 16px;
    padding-block: 4px 18px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--brand-200) transparent;
  }

  .market-banner {
    position: relative;
    display: block;
    aspect-ratio: 3 / 1;
    min-height: 230px;
    border: 1px solid color-mix(in srgb, var(--line) 76%, transparent);
    border-radius: 26px;
    box-shadow: var(--shadow-small);
    overflow: hidden;
    scroll-snap-align: start;
  }

  .recruitment-banner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 34%;
    align-items: center;
    padding: clamp(28px, 5vw, 62px);
    color: white;
    background:
      radial-gradient(circle at 84% 26%, rgba(105, 185, 255, 0.42), transparent 30%),
      linear-gradient(125deg, #061b43 0%, #0757d3 58%, #0b88f5 100%);
  }

  .banner-copy {
    position: relative;
    z-index: 1;
  }

  .banner-copy > span {
    font-size: 0.8rem;
    font-weight: 850;
    letter-spacing: 0.14em;
  }

  .banner-copy h2 {
    margin: 8px 0 6px;
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .banner-copy p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(0.86rem, 1.6vw, 1.05rem);
  }

  .banner-copy strong {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 18px;
    font-size: 0.88rem;
  }

  .recruitment-mark {
    display: grid;
    place-items: center;
    justify-self: end;
    width: clamp(110px, 16vw, 188px);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 38%;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.2);
    transform: rotate(9deg);
    backdrop-filter: blur(12px);
  }

  .recruitment-mark :global(svg) {
    transform: rotate(-9deg);
  }

  .image-banner {
    background: #061b43;
  }

  .image-banner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-sections {
    padding-top: 5px;
  }

  .category-section {
    padding-top: 34px;
  }

  .section-link {
    color: var(--brand-600);
    font-size: 0.9rem;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .banner-section {
      padding-top: 16px;
    }

    .banner-rail {
      grid-auto-columns: 92%;
      gap: 10px;
      padding-bottom: 12px;
    }

    .market-banner {
      min-height: 190px;
      aspect-ratio: 4 / 2.4;
      border-radius: 20px;
    }

    .recruitment-banner {
      grid-template-columns: minmax(0, 1fr) 92px;
      gap: 8px;
      padding: 24px;
    }

    .banner-copy h2 {
      font-size: clamp(1.55rem, 7vw, 2rem);
    }

    .banner-copy p {
      display: none;
    }

    .banner-copy strong {
      margin-top: 14px;
    }

    .recruitment-mark {
      width: 84px;
      border-radius: 30px;
    }

    .recruitment-mark :global(svg) {
      width: 38px;
    }

    .category-section {
      padding-top: 26px;
    }

    .category-section :global(.section-heading) {
      align-items: center;
      flex-direction: row;
    }
  }
</style>
