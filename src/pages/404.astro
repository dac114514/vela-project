---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/urls';
---

<BaseLayout title="页面没有找到" description="你访问的页面不存在。" noIndex>
  <section class="not-found container">
    <span>404</span>
    <h1>这件作品暂时不在展柜里。</h1>
    <p>页面可能已经移动，或者链接输入有误。</p>
    <div>
      <a class="button button-primary" href={href('/')}>返回首页</a>
      <a class="button button-secondary" href={href('/category/all')}>浏览全部作品</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    place-items: center;
    min-height: 64vh;
    padding-block: 80px;
    text-align: center;
  }

  .not-found > span {
    color: var(--brand-600);
    font-size: clamp(5rem, 20vw, 12rem);
    font-weight: 950;
    line-height: 0.8;
    letter-spacing: -0.08em;
    opacity: 0.2;
  }

  .not-found h1 {
    max-width: 700px;
    margin: 26px 0 5px;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .not-found p {
    margin: 8px 0 24px;
    color: var(--ink-600);
  }

  .not-found div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
</style>
