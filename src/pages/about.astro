---
import { LayoutGrid, Pencil, UserRound } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/site';
import { assetHref, href } from '../lib/urls';
---

<BaseLayout title="关于工作室" description="了解蓝桥工作室和独立作者纯水机。">
  <section class="about-hero">
    <div class="container about-grid">
      <div>
        <span class="eyebrow">关于</span>
        <h1>蓝桥工作室</h1>
        <p>{siteInfo.intro}</p>
      </div>
      <picture class="about-banner">
        <source
          srcset={assetHref('/brand/banner-dark-3x1.webp')}
          media="(prefers-color-scheme: dark)"
        />
        <img src={assetHref('/brand/banner-light-3x1.webp')} alt="蓝桥工作室" />
      </picture>
    </div>
  </section>

  <section class="container author-section">
    <div class="section-title">
      <span class="eyebrow">作者</span>
      <h2>创作者信息</h2>
    </div>
    <div class="author-card">
      <div class="author-avatar" aria-label={`${siteInfo.author.name}头像`}>
        {siteInfo.author.avatar
          ? <img src={assetHref(siteInfo.author.avatar)} alt={siteInfo.author.name} />
          : <span>{siteInfo.author.name.slice(0, 1)}</span>}
      </div>
      <div>
        <div class="author-name">
          <h3>{siteInfo.author.name}</h3>
          <span><UserRound size={13} aria-hidden="true" />{siteInfo.author.role}</span>
        </div>
        <p>{siteInfo.author.bio}</p>
        <div class="contact-list">
          {siteInfo.author.contacts.length > 0
            ? siteInfo.author.contacts.map((contact) => (
                <a class="button button-secondary" href={contact.url} target="_blank" rel="noreferrer">
                  {contact.label}
                </a>
              ))
            : null}
        </div>
      </div>
    </div>

    <div class="about-actions">
      <a class="button button-secondary" href={href('/developer')}>
        <UserRound size={16} aria-hidden="true" />开发者主页
      </a>
      <a class="button button-primary" href={href('/category/all')}>
        <LayoutGrid size={17} aria-hidden="true" />浏览全部作品
      </a>
      <a class="button button-secondary" href={href('/author-editor')}>
        <Pencil size={16} aria-hidden="true" />编辑作者
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: 46px 0 22px;
  }

  .about-grid {
    display: grid;
    gap: 24px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.7rem, 8vw, 5.2rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .about-grid p {
    max-width: 720px;
    margin: 13px 0 0;
    color: var(--ink-600);
    font-size: 1.02rem;
  }

  .about-banner {
    display: block;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .about-banner img {
    display: block;
    width: 100%;
  }

  .author-section {
    max-width: 820px;
    padding-top: 34px;
  }

  .section-title {
    margin-bottom: 14px;
  }

  .section-title h2 {
    margin: 0;
    font-size: 1.45rem;
  }

  .author-card {
    display: grid;
    grid-template-columns: 68px 1fr;
    align-items: center;
    gap: 16px;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 16px;
    background: var(--surface);
    box-shadow: var(--shadow-small);
  }

  .author-avatar {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 16px;
    background: var(--brand-600);
    color: white;
    font-size: 1.8rem;
    font-weight: 900;
    overflow: hidden;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .author-card h3 {
    margin: 0;
    font-size: 1.12rem;
  }

  .author-name span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    padding: 3px 7px;
    background: var(--brand-100);
    color: var(--brand-700);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .author-card p {
    margin: 5px 0 0;
    color: var(--ink-600);
    font-size: 0.86rem;
  }

  .contact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  @media (max-width: 640px) {
    .about-hero {
      padding-top: 26px;
    }

    h1 {
      font-size: 2.4rem;
    }

    .about-banner {
      border-radius: 17px;
    }

    .author-section {
      padding-top: 22px;
    }

    .author-card {
      grid-template-columns: 54px minmax(0, 1fr);
      align-items: start;
      gap: 12px;
      padding: 14px;
    }

    .author-avatar {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      font-size: 1.45rem;
    }

    .about-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
