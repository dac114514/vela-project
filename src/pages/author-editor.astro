---
import { ArrowLeft, Copy, Download, RotateCcw, UserRound } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/site';
import { assetHref, href } from '../lib/urls';
---

<BaseLayout title="作者编辑器" description="生成蓝桥工作室作者配置。" noIndex>
  <section class="author-editor">
    <div class="container">
      <a class="back-link" href={href('/about')}>
        <ArrowLeft size={17} aria-hidden="true" />返回关于
      </a>

      <div class="editor-head">
        <div>
          <span class="eyebrow">内容工具</span>
          <h1>作者编辑器</h1>
          <p>填写作者信息，预览并导出配置。</p>
        </div>
        <button class="button button-secondary" type="reset" form="author-form">
          <RotateCcw size={16} aria-hidden="true" />恢复默认
        </button>
      </div>

      <div class="editor-grid">
        <form id="author-form" class="editor-form" data-author-form>
          <section class="form-card">
            <h2>工作室</h2>
            <label>工作室名称<input name="studio" value={siteInfo.shortName} required /></label>
            <label>作品集名称<input name="siteName" value={siteInfo.name} required /></label>
            <label>一句话介绍<textarea name="intro" rows="2" required>{siteInfo.intro}</textarea></label>
          </section>

          <section class="form-card">
            <h2>作者</h2>
            <div class="field-row">
              <label>作者名称<input name="name" value={siteInfo.author.name} required /></label>
              <label>身份<input name="role" value={siteInfo.author.role} required /></label>
            </div>
            <label>头像路径<input name="avatar" value={siteInfo.author.avatar} placeholder="/authors/name/avatar.webp" /></label>
            <label>简介<textarea name="bio" rows="3" required>{siteInfo.author.bio}</textarea></label>
            <label>
              联系方式（每行：名称 | 链接）
              <textarea name="contacts" rows="4" placeholder="GitHub | https://github.com/name">
                {siteInfo.author.contacts.map((item) => `${item.label} | ${item.url}`).join('\n')}
              </textarea>
            </label>
          </section>
        </form>

        <aside class="preview-panel">
          <div class="author-preview">
            <div class="preview-avatar" data-preview-avatar>
              {siteInfo.author.avatar
                ? <img src={assetHref(siteInfo.author.avatar)} alt="" />
                : <span>{siteInfo.author.name.slice(0, 1)}</span>}
            </div>
            <div>
              <div class="preview-name">
                <strong data-preview-name>{siteInfo.author.name}</strong>
                <span><UserRound size={12} aria-hidden="true" /><i data-preview-role>{siteInfo.author.role}</i></span>
              </div>
              <p data-preview-bio>{siteInfo.author.bio}</p>
            </div>
          </div>

          <div class="output-head">
            <span>配置预览</span>
            <button class="button button-secondary" type="button" data-copy-config>
              <Copy size={16} aria-hidden="true" />复制
            </button>
          </div>
          <pre><code data-config-output></code></pre>
          <button class="button button-primary download-button" type="button" data-download-config>
            <Download size={17} aria-hidden="true" />下载 site.ts
          </button>
          <p class="feedback" data-feedback role="status" aria-live="polite"></p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-author-form]');
  const output = document.querySelector<HTMLElement>('[data-config-output]');
  const previewName = document.querySelector<HTMLElement>('[data-preview-name]');
  const previewRole = document.querySelector<HTMLElement>('[data-preview-role]');
  const previewBio = document.querySelector<HTMLElement>('[data-preview-bio]');
  const previewAvatar = document.querySelector<HTMLElement>('[data-preview-avatar]');
  const feedback = document.querySelector<HTMLElement>('[data-feedback]');
  let config = '';

  const quote = (value: FormDataEntryValue | null) => JSON.stringify(String(value ?? '').trim());

  const update = () => {
    if (!form || !output) return;
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const role = String(data.get('role') ?? '').trim();
    const bio = String(data.get('bio') ?? '').trim();
    const avatar = String(data.get('avatar') ?? '').trim();
    const contacts = String(data.get('contacts') ?? '')
      .split(/\r?\n/)
      .map((line) => line.split('|').map((item) => item.trim()))
      .filter(([label, url]) => label && url);

    config = `export const siteInfo = {
  name: ${quote(data.get('siteName'))},
  shortName: ${quote(data.get('studio'))},
  description: "蓝桥工作室作品展示集",
  intro: ${quote(data.get('intro'))},
  copyright: \`© \${new Date().getFullYear()} 蓝桥工作室\`,
  author: {
    name: ${quote(name)},
    role: ${quote(role)},
    avatar: ${quote(avatar)},
    bio: ${quote(bio)},
    contacts: [
${contacts.map(([label, url]) => `      { label: ${JSON.stringify(label)}, url: ${JSON.stringify(url)} }`).join(',\n')}
    ] as Array<{ label: string; url: string }>
  }
};
`;

    output.textContent = config;
    if (previewName) previewName.textContent = name || '未命名作者';
    if (previewRole) previewRole.textContent = role || '作者';
    if (previewBio) previewBio.textContent = bio || '暂无简介';
    if (previewAvatar) {
      previewAvatar.innerHTML = avatar
        ? `<img src="${avatar}" alt="">`
        : `<span>${(name || '作').slice(0, 1)}</span>`;
    }
  };

  form?.addEventListener('input', update);
  form?.addEventListener('reset', () => window.requestAnimationFrame(update));
  update();

  document.querySelector('[data-copy-config]')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(config);
    if (feedback) feedback.textContent = '配置已复制。';
  });

  document.querySelector('[data-download-config]')?.addEventListener('click', () => {
    const blob = new Blob([config], { type: 'text/typescript;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'site.ts';
    link.click();
    URL.revokeObjectURL(link.href);
    if (feedback) feedback.textContent = 'site.ts 已生成。';
  });
</script>

<style>
  .author-editor {
    padding: 40px 0 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    color: var(--brand-600);
    font-weight: 750;
  }

  .editor-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .editor-head p {
    margin: 10px 0 0;
    color: var(--ink-600);
  }

  .editor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 440px);
    align-items: start;
    gap: 18px;
  }

  .editor-form {
    display: grid;
    gap: 14px;
  }

  .form-card,
  .preview-panel {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 18px;
    background: var(--surface);
    box-shadow: var(--shadow-small);
  }

  .form-card {
    display: grid;
    gap: 12px;
  }

  .form-card h2 {
    margin: 0 0 2px;
    font-size: 1rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  label {
    display: grid;
    gap: 5px;
    color: var(--ink-600);
    font-size: 0.78rem;
    font-weight: 750;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 9px 11px;
    outline: 0;
    color: var(--ink-950);
    background: var(--surface-soft);
  }

  input:focus,
  textarea:focus {
    border-color: var(--brand-400);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-200) 50%, transparent);
  }

  textarea {
    resize: vertical;
  }

  .preview-panel {
    position: sticky;
    top: 80px;
  }

  .author-preview {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    border-radius: 15px;
    padding: 12px;
    background: var(--surface-soft);
  }

  .preview-avatar {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: var(--brand-600);
    color: white;
    font-size: 1.45rem;
    font-weight: 900;
    overflow: hidden;
  }

  .preview-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
  }

  .preview-name span {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--brand-600);
    font-size: 0.7rem;
  }

  .preview-name i {
    font-style: normal;
  }

  .author-preview p {
    margin: 4px 0 0;
    color: var(--ink-600);
    font-size: 0.8rem;
  }

  .output-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    font-weight: 800;
  }

  pre {
    max-height: 330px;
    margin: 12px 0;
    border: 1px solid var(--line);
    border-radius: 13px;
    padding: 14px;
    overflow: auto;
    background: var(--surface-soft);
    font-size: 0.76rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  .download-button {
    width: 100%;
  }

  .feedback {
    min-height: 1.4em;
    margin: 8px 0 0;
    color: var(--brand-600);
    font-size: 0.8rem;
  }

  @media (max-width: 860px) {
    .editor-grid {
      grid-template-columns: 1fr;
    }

    .preview-panel {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .author-editor {
      padding-top: 18px;
    }

    .back-link {
      margin-bottom: 16px;
      font-size: 0.86rem;
    }

    .editor-head {
      align-items: stretch;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 18px;
    }

    h1 {
      font-size: 2.1rem;
    }

    .editor-head p {
      font-size: 0.9rem;
    }

    .form-card,
    .preview-panel {
      border-radius: 16px;
      padding: 14px;
    }

    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
