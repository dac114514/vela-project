---
import { Copy, Send, Share2 } from '@lucide/astro';
import { assetHref } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  image?: string;
  icon?: string;
  author: string;
  authorAvatar?: string;
}

const {
  title,
  description,
  image = '/brand/banner-light-16x9.webp',
  icon = '/brand/mark.webp',
  author,
  authorAvatar = ''
} = Astro.props;
const imageUrl = assetHref(image);
const iconUrl = assetHref(icon);
const logoUrl = assetHref('/brand/mark.webp');
const authorAvatarUrl = authorAvatar ? assetHref(authorAvatar) : '';
---

<button class="button button-secondary" type="button" data-share-open>
  <Share2 size={17} aria-hidden="true" />分享作品
</button>

<dialog
  class="share-dialog"
  data-share-dialog
  data-share-title={title}
  data-share-description={description}
  data-share-image={imageUrl}
  data-share-icon={iconUrl}
  data-share-logo={logoUrl}
  data-share-author={author}
  data-share-author-avatar={authorAvatarUrl}
>
  <div class="share-dialog-head">
    <h2>分享{title}</h2>
    <button class="dialog-close" type="button" data-share-close aria-label="关闭">×</button>
  </div>

  <section class="share-panel share-text-panel">
    <div class="share-link-preview" data-share-text></div>
    <div class="share-actions">
      <button class="button button-secondary" type="button" data-copy-link>
        <Copy size={17} aria-hidden="true" />复制文本
      </button>
    </div>
  </section>

  <section class="share-panel share-image-panel">
    <canvas class="share-card-canvas" width="1080" height="1350" data-share-card></canvas>
    <div class="share-actions">
      <button class="button button-primary" type="button" data-save-share-image>
        <Send size={18} aria-hidden="true" />分享图片
      </button>
    </div>
  </section>

  <p class="share-feedback" role="status" aria-live="polite" data-share-feedback></p>
</dialog>

<script>
  import QRCode from 'qrcode';

  const dialogs = document.querySelectorAll<HTMLDialogElement>('[data-share-dialog]');

  function wrapText(
    context: CanvasRenderingContext2D,
    text: string,
    x: number,
    y: number,
    maxWidth: number,
    lineHeight: number,
    maxLines = 2
  ) {
    const characters = [...text];
    const lines: string[] = [];
    let line = '';

    for (const [index, character] of characters.entries()) {
      const next = line + character;
      if (context.measureText(next).width > maxWidth && line) {
        lines.push(line);
        line = character;
        if (lines.length === maxLines - 1) {
          const remaining = index < characters.length - 1;
          if (remaining) {
            while (context.measureText(`${line}…`).width > maxWidth && line.length > 1) {
              line = line.slice(0, -1);
            }
            line += '…';
          }
          break;
        }
      } else {
        line = next;
      }
    }
    if (line) lines.push(line);
    lines.slice(0, maxLines).forEach((item, index) => context.fillText(item, x, y + index * lineHeight));
  }

  async function loadImage(src: string) {
    return await new Promise<HTMLImageElement | null>((resolve) => {
      if (!src) return resolve(null);
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => resolve(null);
      image.src = src;
    });
  }

  function roundedImage(
    context: CanvasRenderingContext2D,
    image: HTMLImageElement,
    x: number,
    y: number,
    width: number,
    height: number,
    radius: number,
    mode: 'cover' | 'contain' = 'cover'
  ) {
    const sourceRatio = image.naturalWidth / image.naturalHeight;
    const targetRatio = width / height;
    let sourceWidth = image.naturalWidth;
    let sourceHeight = image.naturalHeight;
    let sourceX = 0;
    let sourceY = 0;

    if (mode === 'cover') {
      if (sourceRatio > targetRatio) {
        sourceWidth = image.naturalHeight * targetRatio;
        sourceX = (image.naturalWidth - sourceWidth) / 2;
      } else {
        sourceHeight = image.naturalWidth / targetRatio;
        sourceY = (image.naturalHeight - sourceHeight) / 2;
      }
    }

    context.save();
    context.beginPath();
    context.roundRect(x, y, width, height, radius);
    context.clip();
    if (mode === 'contain') {
      context.fillStyle = '#ffffff';
      context.fillRect(x, y, width, height);
      const scale = Math.min(width / image.naturalWidth, height / image.naturalHeight);
      const drawWidth = image.naturalWidth * scale;
      const drawHeight = image.naturalHeight * scale;
      context.drawImage(
        image,
        x + (width - drawWidth) / 2,
        y + (height - drawHeight) / 2,
        drawWidth,
        drawHeight
      );
    } else {
      context.drawImage(
        image,
        sourceX,
        sourceY,
        sourceWidth,
        sourceHeight,
        x,
        y,
        width,
        height
      );
    }
    context.restore();
  }

  for (const dialog of dialogs) {
    const trigger = dialog.previousElementSibling as HTMLButtonElement | null;
    const shareTextElement = dialog.querySelector<HTMLElement>('[data-share-text]');
    const cardCanvas = dialog.querySelector<HTMLCanvasElement>('[data-share-card]');
    const feedback = dialog.querySelector<HTMLElement>('[data-share-feedback]');
    const title = dialog.dataset.shareTitle ?? document.title;
    const description = dialog.dataset.shareDescription ?? '';
    const imageSrc = dialog.dataset.shareImage ?? '';
    const iconSrc = dialog.dataset.shareIcon ?? '';
    const logoSrc = dialog.dataset.shareLogo ?? '';
    const author = dialog.dataset.shareAuthor ?? '';
    const authorAvatarSrc = dialog.dataset.shareAuthorAvatar ?? '';

    const buildAssets = async () => {
      const url = window.location.href;
      if (shareTextElement) shareTextElement.textContent = `【${title}，${description}，${url}】`;
      if (!cardCanvas) return;

      const context = cardCanvas.getContext('2d');
      if (!context) return;
      const gradient = context.createLinearGradient(0, 0, 1080, 1350);
      gradient.addColorStop(0, '#041535');
      gradient.addColorStop(0.58, '#0757d3');
      gradient.addColorStop(1, '#28a6ff');
      context.fillStyle = gradient;
      context.fillRect(0, 0, 1080, 1350);

      context.fillStyle = 'rgba(255, 255, 255, 0.08)';
      context.beginPath();
      context.arc(970, 140, 270, 0, Math.PI * 2);
      context.fill();
      context.beginPath();
      context.arc(70, 1280, 240, 0, Math.PI * 2);
      context.fill();

      const [cover, icon, logo, authorAvatar] = await Promise.all([
        loadImage(imageSrc),
        loadImage(iconSrc),
        loadImage(logoSrc),
        loadImage(authorAvatarSrc)
      ]);

      if (logo) {
        roundedImage(context, logo, 72, 60, 64, 64, 17, 'contain');
      }
      context.fillStyle = '#ffffff';
      context.font = '700 27px system-ui, sans-serif';
      context.fillText('蓝桥工作室', 154, 102);

      context.fillStyle = 'rgba(255, 255, 255, 0.14)';
      context.beginPath();
      context.roundRect(56, 158, 968, 1040, 44);
      context.fill();

      if (cover) {
        roundedImage(context, cover, 80, 182, 920, 490, 30);
      } else {
        context.fillStyle = 'rgba(255, 255, 255, 0.1)';
        context.beginPath();
        context.roundRect(80, 182, 920, 490, 30);
        context.fill();
      }

      if (icon) {
        context.save();
        context.shadowColor = 'rgba(0, 20, 55, 0.28)';
        context.shadowBlur = 28;
        context.shadowOffsetY = 12;
        roundedImage(context, icon, 104, 600, 154, 154, 34);
        context.restore();
      }

      context.fillStyle = '#ffffff';
      context.font = '800 58px system-ui, sans-serif';
      wrapText(context, title, 292, 660, 640, 68, 2);

      context.fillStyle = 'rgba(255, 255, 255, 0.76)';
      context.font = '28px system-ui, sans-serif';
      wrapText(context, description, 104, 824, 850, 42, 2);

      if (authorAvatar) {
        roundedImage(context, authorAvatar, 104, 930, 58, 58, 29);
      }
      context.fillStyle = 'rgba(255, 255, 255, 0.72)';
      context.font = '24px system-ui, sans-serif';
      context.fillText(
        `作者 · ${author}`,
        authorAvatar ? 180 : 104,
        authorAvatar ? 968 : 958
      );

      const qrDataUrl = await QRCode.toDataURL(url, {
        width: 220,
        margin: 2,
        errorCorrectionLevel: 'H',
        color: { dark: '#0757d3', light: '#ffffff' }
      });
      const qrImage = await loadImage(qrDataUrl);
      if (qrImage) {
        context.fillStyle = '#ffffff';
        context.beginPath();
        context.roundRect(724, 982, 276, 276, 26);
        context.fill();
        context.drawImage(qrImage, 752, 1010, 220, 220);
      }

      context.fillStyle = '#ffffff';
      context.font = '700 25px system-ui, sans-serif';
      context.fillText('扫码查看作品', 104, 1128);
      context.fillStyle = 'rgba(255, 255, 255, 0.62)';
      context.font = '21px system-ui, sans-serif';
      context.fillText(new URL(url).host, 104, 1166);
    };

    trigger?.addEventListener('click', async () => {
      dialog.showModal();
      await buildAssets();
    });
    dialog.querySelector('[data-share-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.querySelector('[data-copy-link]')?.addEventListener('click', async () => {
      const text = `【${title}，${description}，${window.location.href}】`;
      await navigator.clipboard.writeText(text);
      if (feedback) feedback.textContent = '链接文案已复制。';
    });

    const saveCanvas = () => {
      if (!cardCanvas) return;
      const link = document.createElement('a');
      link.download = `${title}-分享图.png`;
      link.href = cardCanvas.toDataURL('image/png');
      link.click();
    };

    dialog.querySelector('[data-save-share-image]')?.addEventListener('click', async () => {
      if (!cardCanvas) return;
      const blob = await new Promise<Blob | null>((resolve) => cardCanvas.toBlob(resolve, 'image/png'));
      if (!blob) return;
      const file = new File([blob], `${title}-分享图.png`, { type: 'image/png' });
      if (navigator.share && navigator.canShare?.({ files: [file] })) {
        await navigator.share({
          title,
          text: `【${title}，${description}，${window.location.href}】`,
          files: [file]
        });
        if (feedback) feedback.textContent = '已打开图片分享。';
      } else {
        saveCanvas();
        if (feedback) feedback.textContent = '当前浏览器不支持图片分享，已保存图片。';
      }
    });
  }
</script>
