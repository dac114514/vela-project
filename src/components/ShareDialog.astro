---
import { Copy, Download, Link2, Send, Share2 } from '@lucide/astro';
import { assetHref } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/brand/banner-light-16x9.webp' } = Astro.props;
const imageUrl = assetHref(image);
---

<button class="button button-secondary" type="button" data-share-open>
  <Share2 size={17} aria-hidden="true" />分享作品
</button>

<dialog
  class="share-dialog"
  data-share-dialog
  data-share-title={title}
  data-share-description={description}
  data-share-image={imageUrl}
>
  <div class="share-dialog-head">
    <div>
      <span class="eyebrow">分享</span>
      <h2>分享{title}</h2>
    </div>
    <button class="dialog-close" type="button" data-share-close aria-label="关闭">×</button>
  </div>

  <section class="share-panel">
    <label>格式化链接</label>
    <div class="share-link-preview" data-share-text></div>
    <div class="share-actions">
      <button class="button button-secondary" type="button" data-copy-link>
        <Copy size={17} aria-hidden="true" />复制链接文案
      </button>
      <button class="button button-secondary" type="button" data-share-link>
        <Link2 size={17} aria-hidden="true" />分享链接
      </button>
    </div>
  </section>

  <section class="share-panel">
    <canvas class="share-card-canvas" width="1200" height="630" data-share-card></canvas>
    <div class="share-actions">
      <button class="button button-primary" type="button" data-save-share-image>
        <Send size={17} aria-hidden="true" />保存并分享图片
      </button>
      <button class="button button-secondary" type="button" data-save-image>
        <Download size={17} aria-hidden="true" />仅保存图片
      </button>
    </div>
  </section>

  <p class="share-feedback" role="status" aria-live="polite" data-share-feedback></p>
</dialog>

<script>
  import QRCode from 'qrcode';

  const dialogs = document.querySelectorAll<HTMLDialogElement>('[data-share-dialog]');

  function wrapText(
    context: CanvasRenderingContext2D,
    text: string,
    x: number,
    y: number,
    maxWidth: number,
    lineHeight: number,
    maxLines = 2
  ) {
    const characters = [...text];
    const lines: string[] = [];
    let line = '';

    for (const character of characters) {
      const next = line + character;
      if (context.measureText(next).width > maxWidth && line) {
        lines.push(line);
        line = character;
        if (lines.length === maxLines - 1) break;
      } else {
        line = next;
      }
    }
    if (line) lines.push(line);
    lines.slice(0, maxLines).forEach((item, index) => context.fillText(item, x, y + index * lineHeight));
  }

  async function loadImage(src: string) {
    return await new Promise<HTMLImageElement | null>((resolve) => {
      if (!src) return resolve(null);
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => resolve(null);
      image.src = src;
    });
  }

  for (const dialog of dialogs) {
    const trigger = dialog.previousElementSibling as HTMLButtonElement | null;
    const shareTextElement = dialog.querySelector<HTMLElement>('[data-share-text]');
    const cardCanvas = dialog.querySelector<HTMLCanvasElement>('[data-share-card]');
    const feedback = dialog.querySelector<HTMLElement>('[data-share-feedback]');
    const title = dialog.dataset.shareTitle ?? document.title;
    const description = dialog.dataset.shareDescription ?? '';
    const imageSrc = dialog.dataset.shareImage ?? '';

    const buildAssets = async () => {
      const url = window.location.href;
      if (shareTextElement) shareTextElement.textContent = `【${title}，${description}，${url}】`;
      if (!cardCanvas) return;

      const context = cardCanvas.getContext('2d');
      if (!context) return;
      context.fillStyle = '#f2f7ff';
      context.fillRect(0, 0, 1200, 630);

      context.fillStyle = '#0757d3';
      context.fillRect(0, 0, 18, 630);
      context.fillStyle = '#0d1c38';
      context.font = '700 58px system-ui, sans-serif';
      wrapText(context, title, 78, 142, 690, 72, 2);
      context.fillStyle = '#4b5d78';
      context.font = '30px system-ui, sans-serif';
      wrapText(context, description, 78, 300, 680, 46, 3);
      context.fillStyle = '#0757d3';
      context.font = '700 25px system-ui, sans-serif';
      context.fillText('蓝桥工作室作品集', 78, 536);
      context.fillStyle = '#6c7d96';
      context.font = '21px system-ui, sans-serif';
      context.fillText(new URL(url).host, 78, 574);

      const qrDataUrl = await QRCode.toDataURL(url, {
        width: 260,
        margin: 2,
        errorCorrectionLevel: 'H',
        color: { dark: '#0757d3', light: '#ffffff' }
      });
      const qrImage = await loadImage(qrDataUrl);
      if (qrImage) {
        context.fillStyle = '#ffffff';
        context.beginPath();
        context.roundRect(844, 152, 292, 326, 28);
        context.fill();
        context.drawImage(qrImage, 860, 168, 260, 260);
        context.fillStyle = '#4b5d78';
        context.font = '20px system-ui, sans-serif';
        context.textAlign = 'center';
        context.fillText('扫码查看作品', 990, 454);
        context.textAlign = 'left';
      }

      const cover = await loadImage(imageSrc);
      if (cover) {
        context.save();
        context.globalAlpha = 0.08;
        context.drawImage(cover, 630, -40, 570, 710);
        context.restore();
      }
    };

    trigger?.addEventListener('click', async () => {
      dialog.showModal();
      await buildAssets();
    });
    dialog.querySelector('[data-share-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.querySelector('[data-copy-link]')?.addEventListener('click', async () => {
      const text = `【${title}，${description}，${window.location.href}】`;
      await navigator.clipboard.writeText(text);
      if (feedback) feedback.textContent = '链接文案已复制。';
    });

    dialog.querySelector('[data-share-link]')?.addEventListener('click', async () => {
      const url = window.location.href;
      const text = `【${title}，${description}，${url}】`;
      if (navigator.share) {
        await navigator.share({ title, text, url });
      } else {
        await navigator.clipboard.writeText(text);
        if (feedback) feedback.textContent = '链接文案已复制，可直接粘贴分享。';
      }
    });

    const saveCanvas = () => {
      if (!cardCanvas) return;
      const link = document.createElement('a');
      link.download = `${title}-分享图.png`;
      link.href = cardCanvas.toDataURL('image/png');
      link.click();
    };

    dialog.querySelector('[data-save-image]')?.addEventListener('click', () => {
      saveCanvas();
      if (feedback) feedback.textContent = '分享图片已保存。';
    });

    dialog.querySelector('[data-save-share-image]')?.addEventListener('click', async () => {
      if (!cardCanvas) return;
      saveCanvas();
      const blob = await new Promise<Blob | null>((resolve) => cardCanvas.toBlob(resolve, 'image/png'));
      if (!blob) return;
      const file = new File([blob], `${title}-分享图.png`, { type: 'image/png' });
      if (navigator.share && navigator.canShare?.({ files: [file] })) {
        await navigator.share({
          title,
          text: `【${title}，${description}，${window.location.href}】`,
          files: [file]
        });
        if (feedback) feedback.textContent = '图片已保存并打开分享。';
      } else if (feedback) {
        feedback.textContent = '图片已保存，可从相册或下载中分享。';
      }
    });
  }
</script>
