---
import { ArrowRight } from '@lucide/astro';
import type { ProjectRecord } from '../lib/projects';
import { assetHref, href } from '../lib/urls';

interface Props {
  project: ProjectRecord;
}

const { project } = Astro.props;
const { entry, slug } = project;
const fallback = entry.data.title.slice(0, 1);
---

<article class="project-card">
  <a class="project-card-link" href={href(`/project/${slug}`)}>
    <div class:list={['project-icon', { 'project-icon-fallback': !entry.data.icon }]}>
      {entry.data.icon
        ? <img src={assetHref(entry.data.icon)} alt="" loading="lazy" />
        : <span aria-hidden="true">{fallback}</span>}
    </div>
    <div class="project-card-copy">
      <div class="project-title-row">
        <h3>{entry.data.title}</h3>
        {entry.data.status !== '已发布' && <span class="status-chip">{entry.data.status}</span>}
      </div>
      <span class="project-author">{entry.data.author}</span>
      <p>{entry.data.description}</p>
    </div>
    <span class="card-action" aria-hidden="true">
      查看 <ArrowRight size={15} />
    </span>
  </a>
</article>
